# EcoRAG Environment Configuration
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501

# Audit provenance storage. "local-hash-chain" is a development adapter, not a public chain.
AUDIT_DATABASE_PATH=data/audit.db
# Public-chain deployment is intentionally disabled until an RPC URL and signing key are supplied.
AUDIT_CHAIN_ENABLED=false

# FAISS + chunk metadata persistence (survives server restart)
ECORAG_INDEX_DIR=data/index
ECORAG_INDEX_PERSIST=true

# Structured RAG pipeline logging (Part 25)
ECORAG_LOG_LEVEL=INFO
LOG_FULL_PROMPT=false
ECORAG_EXPOSE_TRACE=false
ECORAG_RELEVANCE_THRESHOLD=0.12
ECORAG_RRF_RELEVANCE_THRESHOLD=0.015

# Single-user local mode; generate with secrets.token_urlsafe(32).
# For multiple users, configure ECORAG_API_KEYS_JSON instead (see docs/security).
ECORAG_API_KEY=
# ECORAG_API_KEYS_JSON=[{"api_key":"<secret>","subject":"user-a","scopes":["read","write"]}]
# Allowed scopes: read, write, tools:invoke. Only read/write are used by current API routes.
ECORAG_API_SCOPES=read,write
ECORAG_API_USER_ID=local-user

# Security gateway limits (optional; defaults are enforced when omitted)
SECURITY_MAX_QUERY_CHARS=20000
SECURITY_MAX_DOCUMENT_CHARS=5000000
SECURITY_MAX_UPLOAD_BYTES=26214400
SECURITY_MAX_FILENAME_CHARS=255
SECURITY_MAX_DOC_ID_CHARS=200
SECURITY_MIN_CHUNK_SIZE=10
SECURITY_MAX_CHUNK_SIZE=4096
SECURITY_MAX_CHUNK_OVERLAP=2048
SECURITY_MAX_REQUEST_BYTES=33554432
SECURITY_PARSE_TIMEOUT_SECONDS=15
SECURITY_MODEL_TIMEOUT_SECONDS=30
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_AUTH_REQUESTS_PER_WINDOW=30
SECURITY_QUERY_REQUESTS_PER_WINDOW=30
SECURITY_SEARCH_REQUESTS_PER_WINDOW=60
SECURITY_INGESTION_REQUESTS_PER_WINDOW=10
SECURITY_MAX_CONCURRENT_QUERIES=4
SECURITY_MAX_CONCURRENT_SEARCHES=8
SECURITY_MAX_CONCURRENT_INGESTIONS=2
SECURITY_MAX_CONCURRENT_PARSES=2
