# Google Gemini API Key (optional for cloud generation and 3072d embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501

# Copy to .env and set a strong random API key for single-user local mode.
# For the desktop client, also set ECORAG_API_KEY in the Windows user environment.
ECORAG_API_KEY=
ECORAG_API_SCOPES=read,write
# For multi-user operation, set ECORAG_API_KEYS_JSON instead and leave ECORAG_API_KEY blank.
# Example: ECORAG_API_KEYS_JSON=[{"api_key":"<secret>","subject":"user-a","scopes":["read","write"]}]
SECURITY_AUTH_REQUESTS_PER_WINDOW=30
