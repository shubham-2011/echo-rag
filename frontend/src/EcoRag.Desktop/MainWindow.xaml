<Window x:Class="EcoRag.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EcoRag.Desktop.ViewModels"
        xmlns:views="clr-namespace:EcoRag.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="EcoRAG — Energy-Aware RAG Platform"
        Height="860" Width="1360"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
            <views:DocumentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TelemetryViewModel}">
            <views:TelemetryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="20,22,20,8">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource NavActiveBrush}" Margin="0,0,12,0">
                            <TextBlock Text="E" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="EcoRAG" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Iris console" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,12">
                        <TextBlock Text="WORKSPACE" Style="{StaticResource SidebarCategoryStyle}"/>
                        <Button Content="Overview" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Dashboard">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Documents" Command="{Binding NavigateCommand}" CommandParameter="Documents">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Documents">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Assistant" Command="{Binding NavigateCommand}" CommandParameter="Chat">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Chat">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Telemetry" Command="{Binding NavigateCommand}" CommandParameter="Telemetry">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Telemetry">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                    <Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Settings">
                                        <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource EmeraldBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="API connected" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,18,0"/>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource InfoPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="FAISS ready" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,18,0"/>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Reranker active" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" Text="EcoRAG  ·  Iris" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
