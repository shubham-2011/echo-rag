<Window x:Class="EcoRag.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EcoRag.Desktop.ViewModels"
        xmlns:views="clr-namespace:EcoRag.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="EcoRAG — Energy-Efficient Desktop Client" Height="750" Width="1200"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <!-- DataTemplates to connect ViewModels to their Views automatically -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
            <views:DocumentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TelemetryViewModel}">
            <views:TelemetryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <!-- Modern Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Row="0" Grid.Column="0" Background="#0B1120" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Branding Header -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,20" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌿" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="EcoRAG" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock Text="Desktop Platform" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Background="#064E3B" CornerRadius="6" Padding="6,3" Margin="0,12,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="Energy-Efficient RAG" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Navigation Links -->
                <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" Margin="0,0,12,0" FontSize="16"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Documents">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📑" Margin="0,0,12,0" FontSize="16"/>
                            <TextBlock Text="Documents"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Chat">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" Margin="0,0,12,0" FontSize="16"/>
                            <TextBlock Text="RAG Chat"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Telemetry">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,12,0" FontSize="16"/>
                            <TextBlock Text="Telemetry"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,12,0" FontSize="16"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Sidebar Footer Status -->
                <Border DockPanel.Dock="Bottom" Padding="16,14" Margin="10" Background="#111827" CornerRadius="8" BorderBrush="#1F2937" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="FAISS L2 Vector DB" FontSize="11" FontWeight="SemiBold" Foreground="#D1D5DB"/>
                        </StackPanel>
                        <TextBlock Text="Tiered Rerank Active" FontSize="10" Foreground="#6B7280" Margin="16,2,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="0" Grid.Column="1" Background="#0F172A">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#090E17" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="EcoRAG Client v1.0.0" FontSize="11" Foreground="#94A3B8" Margin="0,0,16,0"/>
                    <TextBlock Text="Target: FastAPI @ http://127.0.0.1:8000" FontSize="11" Foreground="#64748B" Margin="0,0,16,0"/>
                    <TextBlock Text="BGE Reranker: ON" FontSize="11" Foreground="#34D399"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" Text="⚡ Energy Optimized Mode: -38% FLOPs" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
