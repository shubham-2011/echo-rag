<UserControl x:Class="EcoRag.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:EcoRag.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignHeight="650" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,20,30,30">
            <TextBlock Text="Application Settings &amp; API Configuration" FontSize="26" FontWeight="SemiBold" Foreground="#F3F4F6"/>
            <TextBlock Text="Manage backend endpoints, security boundaries, and telemetry options." 
                       FontSize="14" Foreground="#9CA3AF" Margin="0,4,0,24"/>

            <!-- Backend Connection Settings -->
            <Border Background="#1F2937" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#374151" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="EcoRAG FastAPI Backend Endpoint" FontWeight="SemiBold" FontSize="16" Foreground="#F9FAFB"/>
                    <TextBlock Text="Specify the host URL where your Python FastAPI server is running." FontSize="13" Foreground="#9CA3AF" Margin="0,2,0,12"/>
                    
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Test Connection" Command="{Binding TestConnectionCommand}"
                                Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="16,8" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <TextBox Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#111827" Foreground="#F9FAFB" BorderBrush="#374151" Padding="10,8" FontSize="14">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </DockPanel>

                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="#34D399" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Architecture & Security Rules -->
            <Border Background="#1F2937" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#374151" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Security &amp; Client Boundary Verification" FontWeight="SemiBold" FontSize="16" Foreground="#F9FAFB"/>
                    <TextBlock Text="This desktop client enforces the zero-trust principle established in your architecture audit." FontSize="13" Foreground="#9CA3AF" Margin="0,2,0,12"/>

                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="🔒 No Raw LLM API Keys Stored Locally: Keys remain on the FastAPI backend." Foreground="#E5E7EB" Margin="0,3"/>
                        <TextBlock Text="🔒 No Database Passwords in Client Binaries: Vector store &amp; relational DB are backend-exclusive." Foreground="#E5E7EB" Margin="0,3"/>
                        <TextBlock Text="🔒 Safe Document Transport: Ingestion strictly uses multipart HTTPS with validation." Foreground="#E5E7EB" Margin="0,3"/>
                        <TextBlock Text="🔒 Session Tokens: Stored in OS Protected Storage (Windows PasswordVault / DPAPI)." Foreground="#E5E7EB" Margin="0,3"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Models and Inference Parameters -->
            <Border Background="#1F2937" CornerRadius="12" Padding="20" BorderBrush="#374151" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Configured RAG Models" FontWeight="SemiBold" FontSize="16" Foreground="#F9FAFB"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Embedding Model" FontSize="12" Foreground="#9CA3AF"/>
                            <TextBlock Text="{Binding EmbeddingModel}" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Reranker Model" FontSize="12" Foreground="#9CA3AF"/>
                            <TextBlock Text="{Binding RerankerModel}" FontSize="14" FontWeight="SemiBold" Foreground="#34D399" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
