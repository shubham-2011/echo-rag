<UserControl x:Class="EcoRag.Desktop.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:EcoRag.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ChatViewModel}"
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Chat Header -->
        <DockPanel Grid.Row="0" Margin="10,0,10,12">
            <StackPanel>
                <TextBlock Text="Energy-Aware RAG Assistant" FontSize="22" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                <TextBlock Text="{Binding ActiveEnergySummary}" FontSize="12" Foreground="#34D399" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Content="Clear Chat" Command="{Binding ClearChatCommand}" HorizontalAlignment="Right"
                    Background="#374151" Foreground="#9CA3AF" Padding="12,5" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </DockPanel>

        <!-- Message History List -->
        <Border Grid.Row="1" Background="#111827" CornerRadius="12" BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,14" Padding="10">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,8">
                                <!-- User Bubble -->
                                <Border Background="#1D4ED8" CornerRadius="12,12,2,12" Padding="14,10" MaxWidth="650"
                                        HorizontalAlignment="Right" Margin="80,0,0,0"
                                        Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Content}" Foreground="#FFFFFF" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
                                </Border>

                                <!-- Assistant Bubble -->
                                <StackPanel HorizontalAlignment="Left" MaxWidth="720" Margin="0,0,80,0"
                                            Visibility="{Binding IsAssistant, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border Background="#1F2937" CornerRadius="12,12,12,2" Padding="16,14" BorderBrush="#374151" BorderThickness="1">
                                        <StackPanel>
                                            <!-- Role Title -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="🌿 EcoRAG Assistant" FontWeight="Bold" Foreground="#34D399" FontSize="13"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{} • {0:t}'}" Foreground="#6B7280" FontSize="11" Margin="4,2,0,0"/>
                                            </StackPanel>

                                            <!-- Message Content -->
                                            <TextBlock Text="{Binding Content}" Foreground="#E5E7EB" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>

                                            <!-- Streaming Indicator -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="⚡ Thinking &amp; streaming tokens..." Foreground="#60A5FA" FontSize="12" FontStyle="Italic"/>
                                            </StackPanel>

                                            <!-- Energy Telemetry Pill -->
                                            <Border Background="#064E3B" CornerRadius="8" Padding="10,5" Margin="0,12,0,0"
                                                    Visibility="{Binding HasTelemetry, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Telemetry.FormattedBadge}" Foreground="#6EE7B7" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>

                                            <!-- Citations list -->
                                            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasCitations, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="📚 Retrieved Citations:" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Citations}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#111827" CornerRadius="6" Padding="8" Margin="0,3" BorderBrush="#374151" BorderThickness="1">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold" Foreground="#93C5FD" FontSize="11"/>
                                                                        <TextBlock Text="{Binding PageNumber, StringFormat='{} (Page {0})'}" Foreground="#6B7280" FontSize="11" Margin="4,0,0,0"/>
                                                                        <TextBlock Text="{Binding RelevanceScore, StringFormat='{} • Relevance: {0:P0}'}" Foreground="#34D399" FontSize="11" Margin="6,0,0,0"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Snippet}" Foreground="#9CA3AF" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Query Input Bar -->
        <Border Grid.Row="2" Background="#1F2937" CornerRadius="12" Padding="6,6,8,6" BorderBrush="#374151" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding InputQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Background="Transparent" BorderThickness="0" Foreground="#F9FAFB" FontSize="14"
                         VerticalAlignment="Center" Margin="10,0" 
                         KeyDown="InputQuery_KeyDown"/>

                <Button Grid.Column="1" Content="Send 🚀" Command="{Binding SendMessageCommand}"
                        Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold"
                        Padding="18,10" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
