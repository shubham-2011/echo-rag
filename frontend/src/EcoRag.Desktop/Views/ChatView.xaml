<UserControl x:Class="EcoRag.Desktop.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:EcoRag.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ChatViewModel}"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="28,22,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                <StackPanel>
                    <TextBlock Text="Research assistant" Style="{StaticResource PageTitleStyle}" FontSize="24"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource InfoPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Connected" FontSize="12" Foreground="{DynamicResource InfoPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Energy" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="{Binding CurrentQueryTelemetry.EnergyJoules, StringFormat='{}{0:F1} J'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource EmeraldBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Latency" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="{Binding CurrentQueryTelemetry.TotalLatencyMs, StringFormat='{}{0:F0} ms'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InfoPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Tokens" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="{Binding CurrentQueryTelemetry.TotalTokens}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <Border Background="{DynamicResource NavActiveBrush}"
                                        CornerRadius="16,16,4,16"
                                        Padding="16,12"
                                        MaxWidth="640"
                                        HorizontalAlignment="Right"
                                        Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="You" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Content}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel MaxWidth="720" HorizontalAlignment="Left"
                                            Visibility="{Binding IsAssistant, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="EcoRAG" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Content}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="14.5" LineHeight="24"/>

                                    <TextBlock Text="Generating response..." Margin="0,10,0,0"
                                               Foreground="{DynamicResource InfoPrimaryBrush}" FontSize="12" FontStyle="Italic"
                                               Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Expander Header="Sources" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,12,0,0"
                                              IsExpanded="True"
                                              Visibility="{Binding HasCitations, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Background="Transparent" BorderThickness="0">
                                        <ItemsControl ItemsSource="{Binding Citations}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold" Foreground="{DynamicResource InfoPrimaryBrush}" FontSize="12"/>
                                                                <TextBlock Text="{Binding PageLabel, StringFormat='{}  {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ChunkId, StringFormat='{}  {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding RelevanceScore, StringFormat='{}  score {0:F2}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Snippet}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <Border Margin="0,12,0,0" Padding="0,10,0,0"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                                            Visibility="{Binding HasTelemetry, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <WrapPanel>
                                            <TextBlock Margin="0,0,16,4" FontSize="12" Foreground="{DynamicResource EmeraldBrush}" FontWeight="SemiBold"
                                                       Text="{Binding Telemetry.EnergyJoules, StringFormat='{}{0:F1} J'}"/>
                                            <TextBlock Margin="0,0,16,4" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Telemetry.EnergySavedPercentage, StringFormat='{}{0:F0}% saved'}"/>
                                            <TextBlock Margin="0,0,16,4" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Telemetry.TotalLatencyMs, StringFormat='{}{0:F0} ms'}"/>
                                            <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Telemetry.TotalTokens, StringFormat='{}{0} tokens'}"/>
                                        </WrapPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="6,6,6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBlock Text="Ask a question about your documents" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="14" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InputQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding InputQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding InputQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 FontSize="14" Padding="8,10" VerticalAlignment="Center"
                                 KeyDown="InputQuery_KeyDown"/>
                    </Grid>
                    <Button Grid.Column="1" Content="Send" Command="{Binding SendMessageCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,22">
                <StackPanel>
                    <TextBlock Text="Energy" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="This answer versus a full-context baseline. Values are CurrentQueryTelemetry (estimated unless labeled measured)." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>

                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentQueryTelemetry.MeasurementType, StringFormat='CURRENT QUERY ({0})'}" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="{Binding CurrentQueryTelemetry.RequestId, StringFormat='RequestId {0}'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CurrentQueryTelemetry.EnergyJoules, StringFormat='{}{0:F1} J'}" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Saved" Style="{StaticResource SectionLabelStyle}"/>
                                    <TextBlock Text="{Binding CurrentQueryTelemetry.SavedJoules, StringFormat='{}{0:F1} J'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource EmeraldBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Reduction" Style="{StaticResource SectionLabelStyle}"/>
                                    <TextBlock Text="{Binding CurrentQueryTelemetry.EnergySavedPercentage, StringFormat='{}{0:F1}%'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource EmeraldBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,14,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Baseline" Width="64" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <ProgressBar Value="100" Maximum="100" Height="6" Foreground="{DynamicResource AmberBrush}"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="EcoRAG" Width="64" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <ProgressBar Value="{Binding CurrentQueryTelemetry.EcoVsBaselinePercent, Mode=OneWay}" Maximum="100" Height="6" Foreground="{DynamicResource EmeraldBrush}"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="WHERE IT WENT (Estimated)" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Retrieval" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ProgressBar Grid.Column="1" Value="{Binding CurrentQueryTelemetry.RetrievalShare, Mode=OneWay}" Maximum="100" Height="5" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource InfoPrimaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding CurrentQueryTelemetry.RetrievalJoules, StringFormat='{}{0:F1} J'}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fusion" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ProgressBar Grid.Column="1" Value="{Binding CurrentQueryTelemetry.FusionShare, Mode=OneWay}" Maximum="100" Height="5" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource InfoPrimaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding CurrentQueryTelemetry.FusionJoules, StringFormat='{}{0:F1} J'}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rerank" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ProgressBar Grid.Column="1" Value="{Binding CurrentQueryTelemetry.RerankShare, Mode=OneWay}" Maximum="100" Height="5" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding CurrentQueryTelemetry.RerankJoules, StringFormat='{}{0:F1} J'}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Context" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ProgressBar Grid.Column="1" Value="{Binding CurrentQueryTelemetry.ContextShare, Mode=OneWay}" Maximum="100" Height="5" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding CurrentQueryTelemetry.ContextJoules, StringFormat='{}{0:F1} J'}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Generation" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ProgressBar Grid.Column="1" Value="{Binding CurrentQueryTelemetry.GenerationShare, Mode=OneWay}" Maximum="100" Height="5" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource WarningOrangeBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding CurrentQueryTelemetry.GenerationJoules, StringFormat='{}{0:F1} J'}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="COMPARE" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Column="1" Text="Baseline" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="EcoRAG" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="1" Text="Energy" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentQueryTelemetry.BaselineJoules, StringFormat='{}{0:F1} J'}" FontSize="12" Foreground="{DynamicResource AmberBrush}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CurrentQueryTelemetry.EnergyJoules, StringFormat='{}{0:F1} J'}" FontSize="12" Foreground="{DynamicResource EmeraldBrush}" HorizontalAlignment="Right" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Text="Latency" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentQueryTelemetry.TotalLatencyMs, StringFormat='{}{0:F0} ms'}" FontSize="12" HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CurrentQueryTelemetry.TotalLatencyMs, StringFormat='{}{0:F0} ms'}" FontSize="12" HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{DynamicResource InfoPrimaryBrush}"/>

                            <TextBlock Grid.Row="3" Text="Tokens" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentQueryTelemetry.TotalTokens}" FontSize="12" HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CurrentQueryTelemetry.TotalTokens}" FontSize="12" HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock Grid.Row="4" Text="Context" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentQueryTelemetry.ContextTokens}" FontSize="12" HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding CurrentQueryTelemetry.ContextTokens}" FontSize="12" HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock Grid.Row="5" Text="Retrieved" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentQueryTelemetry.RetrievedCount}" FontSize="12" HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding CurrentQueryTelemetry.RetrievedCount}" FontSize="12" HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
