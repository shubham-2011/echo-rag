<UserControl x:Class="EcoRag.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:EcoRag.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignHeight="650" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,20,30,30">
            <!-- Header section -->
            <TextBlock Text="System Overview &amp; Telemetry" FontSize="26" FontWeight="SemiBold" Foreground="#F3F4F6"/>
            <TextBlock Text="Monitor indexed documents, FAISS vector index status, and compute energy savings." 
                       FontSize="14" Foreground="#9CA3AF" Margin="0,4,0,24"/>

            <!-- Metric Cards Grid -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <!-- Documents Card -->
                <Border Background="#1F2937" CornerRadius="12" Padding="20" Margin="0,0,12,0" BorderBrush="#374151" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📄 ACTIVE DOCUMENTS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding TotalDocuments}" FontSize="32" FontWeight="Bold" Foreground="#60A5FA" Margin="0,8,0,0"/>
                        <TextBlock Text="Indexed in Vector DB" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Chunks Card -->
                <Border Background="#1F2937" CornerRadius="12" Padding="20" Margin="6,0,6,0" BorderBrush="#374151" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🧩 EXTRACTED CHUNKS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding TotalChunks}" FontSize="32" FontWeight="Bold" Foreground="#34D399" Margin="0,8,0,0"/>
                        <TextBlock Text="FAISS L2 Indexed" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Energy Saved Card -->
                <Border Background="#1F2937" CornerRadius="12" Padding="20" Margin="6,0,6,0" BorderBrush="#059669" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⚡ ENERGY SAVED" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text="{Binding TotalEnergySavedJoules, StringFormat='{}{0:N1} J'}" FontSize="32" FontWeight="Bold" Foreground="#10B981" Margin="0,8,0,0"/>
                        <TextBlock Text="~38% vs. Baseline RAG" FontSize="12" Foreground="#D1FAE5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Average Latency Card -->
                <Border Background="#1F2937" CornerRadius="12" Padding="20" Margin="12,0,0,0" BorderBrush="#374151" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⏱️ AVG RESPONSE TIME" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding AverageLatencyMs, StringFormat='{}{0:N0} ms'}" FontSize="32" FontWeight="Bold" Foreground="#FBBF24" Margin="0,8,0,0"/>
                        <TextBlock Text="Retrieval + Rerank + LLM" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Backend Status Banner -->
            <Border Background="#111827" CornerRadius="10" Padding="16,12" Margin="0,0,0,24" BorderBrush="#1F2937" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Backend Status:" FontWeight="SemiBold" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BackendStatus}" Foreground="#34D399" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Refresh Stats" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"
                            Background="#374151" Foreground="#FFFFFF" Padding="12,6" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Recent Documents Section -->
            <TextBlock Text="Recently Indexed Knowledge Items" FontSize="18" FontWeight="SemiBold" Foreground="#F3F4F6" Margin="0,0,0,12"/>
            <Border Background="#1F2937" CornerRadius="12" Padding="16" BorderBrush="#374151" BorderThickness="1">
                <ItemsControl ItemsSource="{Binding RecentDocuments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="10,12">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="📄" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#E5E7EB" FontSize="14"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding FileSizeFormatted}" Foreground="#9CA3AF" FontSize="12" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding ChunkCount, StringFormat='{}{0} chunks'}" Foreground="#9CA3AF" FontSize="12" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding IndexingEnergyJoules, StringFormat='{}Energy: {0} J'}" Foreground="#34D399" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#064E3B" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="#34D399" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
